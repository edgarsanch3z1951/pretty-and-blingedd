---
import BookButton from "./BookButton.astro";
import InstagramLink from "./InstagramLink.astro";
import Sparkle from "./Sparkle.astro";

const trust = [
  { icon: "✨", label: "Certified Dental Assistant" },
  { icon: "🏠", label: "Home-Based" },
  { icon: "🚗", label: "Mobile Available" },
  { icon: "📍", label: "Ventura County" },
];
---

<header
  class="relative flex min-h-[calc(100dvh-4.5rem)] flex-col justify-center overflow-hidden px-5 pb-6 pt-6 lg:min-h-screen lg:px-8 lg:pb-16 lg:pt-12"
>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-48 bg-[radial-gradient(ellipse_at_top,rgb(236_30_121_/_0.18),transparent_62%)]"
    aria-hidden="true"
  >
  </div>

  <InstagramLink
    class="absolute right-4 top-[max(0.85rem,env(safe-area-inset-top))] z-20 grid h-11 w-11 place-items-center rounded-full bg-white text-lip shadow-[0_8px_20px_rgb(236_30_121_/_0.22)] ring-1 ring-blush lg:hidden"
  />

  <div class="relative mx-auto flex w-full max-w-2xl flex-col items-center text-center">
    <img
      src="/images/logo.webp"
      alt="Pretty and Blingedd logo — glossy pink lips with a sparkling tooth gem"
      width="88"
      height="88"
      fetchpriority="high"
      decoding="async"
      class="h-[4.25rem] w-[4.25rem] rounded-full object-cover ring-2 ring-white shadow-[0_8px_24px_rgb(236_30_121_/_0.28)] sm:h-24 sm:w-24"
    />

    <p class="mt-3 font-sans text-[0.7rem] font-bold uppercase tracking-[0.28em] text-lip sm:mt-4 sm:text-xs">
      Pretty and Blingedd
    </p>

    <h1 class="mt-2 max-w-[18ch] font-display text-[2.05rem] font-medium italic leading-[1.12] text-ink sm:text-5xl lg:text-6xl">
      Bright smiles. Pretty gems. At your door.
    </h1>

    <p class="mt-3 max-w-md text-[0.92rem] leading-relaxed text-ink-muted sm:mt-4 sm:text-base">
      Professional teeth whitening and tooth gems by a Certified Dental Assistant.
      Home-based service with mobile visits across Ventura County.
    </p>

    <BookButton class="mt-5 w-full max-w-xs sm:mt-6" />

    <ul
      class="mt-5 grid w-full grid-cols-2 gap-x-2 gap-y-2 text-left text-[0.72rem] font-semibold text-ink sm:mt-7 sm:flex sm:flex-wrap sm:justify-center sm:gap-x-5 sm:text-sm sm:text-center"
    >
      {
        trust.map((item) => (
          <li class="flex items-center gap-1.5 rounded-full bg-white/70 px-2.5 py-1.5 sm:bg-transparent sm:px-0 sm:py-0">
            <span aria-hidden="true">{item.icon}</span>
            <span>{item.label}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="sparkle-rule mx-auto mt-8 w-full max-w-xs text-lip" aria-hidden="true">
    <Sparkle class="h-3.5 w-3.5" />
  </div>
</header>
