---
interface Props {
  class?: string;
  showLabel?: boolean;
}

const instagram =
  import.meta.env.PUBLIC_INSTAGRAM_URL?.trim() || "https://www.instagram.com/prettyandblingedd/";
const { class: className = "", showLabel = false } = Astro.props;
---

<a
  href={instagram}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[className]}
  aria-label="Pretty and Blingedd on Instagram"
>
  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.7"></rect>
    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7"></circle>
    <circle cx="17.2" cy="6.8" r="1" fill="currentColor"></circle>
  </svg>
  {showLabel ? <span>Instagram</span> : null}
</a>
